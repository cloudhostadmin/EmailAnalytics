<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gita Mail (EmailAnalytics) at https://gitapress.in/emailanalytics

  Where this file goes: an empty folder, e.g. C:\inetpub\emailanalytics-proxy\web.config
  In IIS Manager: Sites > gitapress.in > right-click > Add Application...
      Alias: emailanalytics      Physical path: C:\inetpub\emailanalytics-proxy
      Application pool: one with ".NET CLR version = No Managed Code"
  Needs: IIS URL Rewrite + Application Request Routing (ARR) with "Enable proxy" ticked.

  Because this file sits in the /emailanalytics application, IIS hands the rules the path
  WITHOUT "emailanalytics/", so /emailanalytics/api/health reaches Node as /api/health.
  The port must match PORT in the app's .env (default 8888).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- do not inherit the gitapress.in site's own rules (catch-alls, redirects to another domain, etc.) -->
        <clear />
        <rule name="EmailAnalytics - force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/emailanalytics/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="EmailAnalytics - proxy to Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8888/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- let the app's own JSON errors through instead of IIS error pages -->
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <!-- CSV uploads (book catalogue, FAQs) and service account key: up to 50 MB -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
